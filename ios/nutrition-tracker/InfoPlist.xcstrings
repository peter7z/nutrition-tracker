    "NSHealthShareUsageDescription" : {
      "comment" : "Privacy - Health Share Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bocado Log reads your weight, activity and nutrition data from Apple Health to show your history and progress."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bocado Log lee tus datos de peso, actividad y nutrición de Apple Health para mostrar tu historial y progreso."
          }
        }
      }
    },
    "NSHealthUpdateUsageDescription" : {
      "comment" : "Privacy - Health Update Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bocado Log saves calories and nutrients from your food diary and waist measurements to Apple Health when you enable syncing."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bocado Log guarda en Apple Health las calorías y los nutrientes de tu diario y las medidas de cintura cuando activás la sincronización."
          }
        }
      }
