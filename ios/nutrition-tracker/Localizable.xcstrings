    "A blank target keeps its current value. If no current value exists for a blank target, the proposal cannot be accepted.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un objetivo en blanco conserva su valor actual. Si no existe un valor actual, no se puede aceptar la propuesta."
          }
        }
      }
    },
    "A goal review needs at least 10 of 14 complete nutrition days and 6 weight days, with at least 3 weight days in each 7-day week.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para revisar los objetivos, necesitás al menos 10 de 14 días completos de nutrición y 6 días con peso, con al menos 3 días con peso en cada semana de 7 días."
          }
        }
      }
    },
    "A goal review requires at least 10 complete nutrition days and 6 weight days, including 3 weight days in each week.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para revisar los objetivos se necesitan al menos 10 días completos de nutrición y 6 días con peso, con 3 días con peso en cada semana."
          }
        }
      }
    },
    "A more complete picture of your day": {
      "extractionState": "stale",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una visión más completa de tu día"
          }
        }
      }
    },
    "A recipe is a preparation, not a meal record. Log only the amount you actually consumed; leftovers remain uncounted.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una receta es una preparación. Registrá por separado solo la cantidad que realmente comiste; los sobrantes no se contabilizan."
          }
        }
      }
    },
    "A serving size or measured density is required when recording this product with a different unit.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para registrar este producto con otra unidad, necesitás indicar el tamaño de la porción o la densidad medida."
          }
        }
      }
    },
    "A valid quantity and explicit unit conversion are required.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se necesita una cantidad válida y una conversión de unidades explícita."
          }
        }
      }
    },
