    "Apple Health activity uses merged daily exercise minutes and active-energy statistics. Individual workouts are not added again.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La actividad de Apple Health usa las estadísticas diarias consolidadas de minutos de ejercicio y energía activa. Los entrenamientos individuales no se vuelven a sumar."
          }
        }
      }
    },
