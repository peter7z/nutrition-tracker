    },
    "Your account and server history are kept. Apple Health stays on this device." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu cuenta y el historial del servidor se conservan. Apple Health permanece en este dispositivo."
          }
        }
      }
    },
    "Your daily goals" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus objetivos diarios"
          }
        }
      }
    },
    "Your food diary's calories, macros, fiber, vitamins and minerals will be saved to Apple Health. New and edited diary entries will sync when your diary refreshes. You can stop sync here; records already saved in Health will remain." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las calorías, los macros, la fibra, las vitaminas y los minerales de tu diario se guardarán en Apple Health. Las entradas nuevas o editadas se sincronizarán al actualizar el diario. Podés detener la sincronización aquí; los registros ya guardados permanecerán en Health."
          }
        }
      }
    },
    "Your food diary's calories, protein, carbohydrates, total fat, saturated fat and fiber will be saved to Apple Health. New and edited diary entries will sync when your diary refreshes. You can stop sync here; records already saved in Health will remain." : {
      "extractionState" : "stale",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las calorías, proteínas, carbohidratos, grasas totales, grasas saturadas y fibra del diario se guardarán en Apple Health. Las entradas nuevas o editadas se sincronizarán al actualizar el diario. Podés detener la sincronización aquí; los registros ya guardados permanecerán en Health."
          }
        }
      }
    },
    "Your meals" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus comidas"
          }
        }
      }
    },
    "Your nutrition, day by day." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu nutrición, día a día."
          }
        }
      }
    },
    "Your session expired. Sign in again." : {
      "extractionState" : "stale",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu sesión venció. Iniciá sesión de nuevo."
          }
        }
      }
    },
    "Apple Health supports waist circumference, so Bocado syncs the waist measurement at the navel. Neck, minimum waist, biceps, thigh, hip and chest stay in Bocado and MCP." : {
      "localizations" : {
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Apple Health admite la circunferencia de cintura; Bocado sincroniza la medida a la altura del ombligo. El cuello, la cintura mínima, el bíceps, el muslo, la cadera y el pecho quedan en Bocado y MCP." } }
      }
    },
    "Body measurements in Apple Health" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Medidas corporales en Apple Health" } } } },
    "Could not enable waist sync to Apple Health. Check Health access and try again." : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "No se pudo activar la sincronización de cintura con Apple Health. Revisá el acceso e intentá de nuevo." } } } },
    "Could not read body measurement sync settings. Apple Health was not changed." : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "No se pudo leer la configuración de sincronización de medidas. Apple Health no se modificó." } } } },
    "Could not save body measurement sync settings. Try again." : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "No se pudo guardar la configuración de sincronización de medidas. Intentá de nuevo." } } } },
    "Could not sync body measurements to Apple Health. Check Health access and try again." : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "No se pudieron sincronizar las medidas con Apple Health. Revisá el acceso e intentá de nuevo." } } } },
    "Enable waist sync" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Activar sincronización de cintura" } } } },
    "Enable waist sync?" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "¿Activar la sincronización de cintura?" } } } },
    "Last waist sync" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Última sincronización de cintura" } } } },
    "Sign in to sync body measurements." : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Iniciá sesión para sincronizar las medidas corporales." } } } },
    "Stop waist sync" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Detener sincronización de cintura" } } } },
    "Sync waist now" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Sincronizar cintura ahora" } } } },
    "Bocado will save waist measurements taken at the navel to Apple Health. Other measurements and the minimum waist measurement remain in Bocado. Stopping sync will keep records already saved in Health." : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Bocado guardará en Apple Health las medidas de cintura tomadas a la altura del ombligo. Las demás medidas y la cintura mínima quedan en Bocado. Al detener la sincronización, se conservan los registros que ya estén en Salud." } } } },
    "Zinc" : {
