    "Complete days require explicitly recorded whole-day totals. Logged meals alone and Apple Health totals do not prove that a day is complete." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Complete days require explicitly recorded whole-day totals. Logged meals alone and Apple Health totals do not prove that a day is complete."
          }
        },
