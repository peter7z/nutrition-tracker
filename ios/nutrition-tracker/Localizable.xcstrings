      }
    },
    "The assistant may explain the recorded pattern. It cannot change your goals automatically.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El asistente puede explicar el patrón de los registros. No puede cambiar tus objetivos automáticamente."
          }
        }
      }
    },
    "The daily point uses the latest valid reading that day. The moving average uses only available daily readings in the prior seven calendar days.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El dato diario usa la última medición válida de ese día. El promedio móvil usa solo las mediciones diarias disponibles de los siete días calendario anteriores."
          }
        }
      }
    },
    "The export can contain personal data. Choose where to share or save it.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La exportación puede incluir datos personales. Elegí dónde compartirla o guardarla."
          }
        }
      }
    },
    "The proposed goals are incomplete or invalid. Your saved goals were not changed.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los objetivos propuestos están incompletos o no son válidos. Tus objetivos guardados no cambiaron."
          }
        }
      }
    },
    "The record keeps a copy of this version's nutrition. Editing the product later does not rewrite previous meals.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El registro conserva una copia de la información nutricional de esta versión. Editar después el producto no modifica comidas anteriores."
          }
        }
      }
    },
    "The request failed. Your saved records are unchanged.": {
