# Copy to a private .env file; never commit it. Production and development use separate DBs and keys.
NUTRITION_ENV=development
NUTRITION_DATABASE=./data/nutrition.sqlite3
OPENAI_API_KEY=
# Set an explicitly chosen Responses+vision+strict-schema capable model.
OPENAI_MODEL=
# Set current prices for the selected model from the official pricing page; no guessed default.
AI_INPUT_USD_PER_MILLION=0
AI_OUTPUT_USD_PER_MILLION=0
AI_USER_DAILY_BUDGET_USD=0.50
AI_GLOBAL_DAILY_BUDGET_USD=5
AI_REQUESTS_PER_USER_HOUR=30
AI_TIMEOUT_SECONDS=30
AI_MAX_OUTPUT_TOKENS=1800
AUTH_REQUESTS_PER_MINUTE=10

# Optional managed PostgreSQL connection (takes precedence over NUTRITION_DATABASE)
# DATABASE_URL=postgresql://user:password@host/database

# Canonical HTTPS URL for OAuth discovery/resource binding on a deployment
NUTRITION_PUBLIC_URL=http://localhost:8000
# Exact additional OAuth callback URLs, comma-separated
OAUTH_REDIRECT_URIS=https://chatgpt.com/connector_platform_oauth_redirect
